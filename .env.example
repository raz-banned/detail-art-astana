# Copy to .env and fill in. Values: Supabase dashboard → Project Settings → API
# (project id is also in supabase/config.toml).

# Client bundle
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# SSR fallbacks (same values as above)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_PROJECT_ID=""

# Server-only admin client, bypasses RLS. Never expose to client code.
# SUPABASE_SERVICE_ROLE_KEY=""
